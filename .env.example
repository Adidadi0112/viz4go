# Viz4GO Environment Configuration Example
# Copy this file to .env and customize as needed

# Backend Configuration
FLASK_ENV=production
FLASK_DEBUG=0

# Port Configuration
# Backend port (default: 5000)
BACKEND_PORT=5000

# Frontend port (default: 8080)
FRONTEND_PORT=8080

# Backend URL for frontend (default: http://localhost:5000)
# For Docker deployment, this should point to where users access the backend
BACKEND_URL=http://localhost:5000

# Data Persistence
# Uncomment to use custom paths for data storage
# RESOURCES_PATH=./viz4go_backend/_resources
# DATA_PATH=./viz4go_backend/data

# Docker Configuration
# COMPOSE_PROJECT_NAME=viz4go
